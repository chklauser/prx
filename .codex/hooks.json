{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(jj root)/.codex/hooks/format-csharp.sh\"",
            "timeout": 600,
            "statusMessage": "Formatting C# with CSharpier"
          }
        ]
      }
    ]
  }
}
